# Copy to .env.local. Never commit real values.
# Supabase dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public URL of this app (used in email links). http://localhost:3000 locally, your domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_. Used to create staff accounts and store contact messages.
SUPABASE_SERVICE_ROLE_KEY=

# Demo accounts are provisioned with `npm run provision:demo` and are hidden/banned when disabled.
# Use three different strong passwords (12+ characters) stored only in server environment secrets.
DEMO_ACCESS_ENABLED=false
DEMO_ADMIN_PASSWORD=
DEMO_STAFF_PASSWORD=
DEMO_CUSTOMER_PASSWORD=

# Reserved for the billing job (not built yet). Optional. Generate: openssl rand -hex 32
CRON_SECRET=

# Reserved for invoice email (not built yet). Optional.
EMAIL_API_KEY=
EMAIL_FROM="Brightloop <billing@yourdomain.com>"
